# Server-side only. Read by src/lib/forms.functions.ts for the contact and
# playbook form inserts. Set these on the Railway service.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-publishable-or-anon-key>

# Optional. When both are set, every contact and playbook submission also sends a
# notification email through Resend. Without them the row is still saved, silently.
RESEND_API_KEY=<resend-api-key>
NOTIFY_EMAIL=contact@demazetech.com
# Must be a domain you have verified in Resend. Defaults to Resend's sandbox sender.
NOTIFY_FROM=DEMAze site <website@demazetech.com>
